# Copy to deploy/.env and fill in. This file is the only place secrets live on
# the VPS; deploy/.env is in .gitignore and `gwctl validate` checks that.
# Originals belong in the owner's password manager.

# Public hostname served by Caddy. A certificate is obtained automatically.
GATEWAY_DOMAIN=gw.example.com
# Optional, for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# Master key of the LiteLLM proxy. Used by gwctl only, never handed to a
# consumer. Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-master-REPLACE_ME

# Vendor keys. They never leave this VPS: consumers reach vendors only through
# the contract in docs/CONTRACT.md.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Postgres. Generate with: openssl rand -hex 24
POSTGRES_USER=litellm
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=litellm

# Pinned proxy version. Upgrade deliberately, then run `make smoke`.
LITELLM_VERSION=v1.63.11-stable
